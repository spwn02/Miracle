{
  "version": 12,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 4,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "MIRACLE_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Miracle Debug",
      "description": "Standalone debug build using the compiler selected by the environment or CMake user preset.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MIRACLE_OPTIMIZED": "AUTO"
      }
    },
    {
      "name": "release",
      "displayName": "Miracle Release",
      "description": "Standalone optimized release build using the compiler selected by the environment or CMake user preset.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MIRACLE_OPTIMIZED": "AUTO"
      }
    },
    {
      "name": "tests",
      "displayName": "Miracle Tests",
      "description": "Standalone debug build with Miracle's Switch-powered self-tests enabled.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MIRACLE_OPTIMIZED": "AUTO",
        "MIRACLE_BUILD_EXAMPLES": "ON",
        "MIRACLE_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "tests",
      "configurePreset": "tests"
    }
  ],
  "testPresets": [
    {
      "name": "tests",
      "configurePreset": "tests",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
